# HubSpot Service Key (Settings -> Integrations -> Service Keys, public beta)
# or, if unavailable on this portal, a Private App access token with the
# same scopes -- both are used identically as "Authorization: Bearer <token>",
# so no code change is needed either way.
#
# Required scopes:
#   crm.objects.contacts.read
#   crm.objects.deals.read
#   crm.schemas.contacts.read
#   crm.schemas.deals.read
#   crm.pipelines.read (or the closest available scope for pipeline/stage metadata)
HUBSPOT_ACCESS_TOKEN=

# Optional: override the contact-fetch cutoff date (format YYYY-MM-DD).
# Defaults to Jan 1 of the report year if unset. A later date means a
# smaller, faster fetch -- e.g. set to 2026-04-01 to only fetch contacts
# created on/after that date. See fetch_contacts()'s docstring in
# generate_funnel_report.py for the trade-off this involves.
FETCH_CONTACTS_SINCE=

# Optional diagnostic: set to 1 to print HubSpot's own reported "total"
# match count after each of the 4 overall filters is added to the contact
# search ONE AT A TIME (before the real fetch runs), to pinpoint exactly
# which filter -- if any -- causes an unexpected drop for this specific
# token. Useful if the final fetched-contact-count looks implausibly low.
DEBUG_FETCH_FILTERS=
