# HubSpot Service Key (Settings -> Integrations -> Service Keys, public beta)
# or, if unavailable on this portal, a Private App access token with the
# same scopes -- both are used identically as "Authorization: Bearer <token>",
# so no code change is needed either way.
#
# Required scopes:
#   crm.objects.contacts.read
#   crm.objects.deals.read
#   crm.schemas.contacts.read
#   crm.schemas.deals.read
#   crm.pipelines.read (or the closest available scope for pipeline/stage metadata)
HUBSPOT_ACCESS_TOKEN=
